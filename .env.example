# DrZeroTrust Patreon Monitor - environment template
#
# V1 is offline and mock-only. None of these variables are read by V1.
# They are listed here so the layout is ready for future versions.
# DO NOT put real secrets in this file. Copy to `.env` and fill in
# locally; `.env` should be gitignored.

# ---- SEC EDGAR (future) ----
# Required by SEC for programmatic access. Not used in V1.
SEC_USER_AGENT="DrZeroTrust Research contact@example.com"

# ---- Capitol Hill disclosures (future) ----
# Placeholder for any third-party PTR data source. Not used in V1.
CAPITOL_TRADES_API_KEY=""

# ---- Google Drive archive (future) ----
# Path to a service-account JSON key file. Not used in V1.
GOOGLE_DRIVE_CREDENTIALS_PATH=""
GOOGLE_DRIVE_FOLDER_ID=""

# ---- Patreon (future, manual-review only) ----
# V1 NEVER posts to Patreon. These are reserved for a future
# draft-creation flow that will still require human review before
# anything is published.
PATREON_ACCESS_TOKEN=""
PATREON_CAMPAIGN_ID=""

# ---- Runtime ----
# Where generated drafts are written.
OUTPUT_DIR="output"
# Where state JSON files are kept.
STATE_DIR="state"
